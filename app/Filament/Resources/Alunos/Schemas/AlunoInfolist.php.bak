<?php

namespace App\Filament\Resources\Alunos\Schemas;

use Filament\Infolists\Components\TextEntry;
use Filament\Schemas\Schema;

class AlunoInfolist
{
    public static function configure(Schema $schema): Schema
    {
        return $schema
            ->components([
                TextEntry::make('cpf'),
                TextEntry::make('nome'),
                TextEntry::make('foto_path')
                    ->placeholder('-'),
                TextEntry::make('sexo'),
                TextEntry::make('email')
                    ->label('Email address')
                    ->placeholder('-'),
                TextEntry::make('telefone_estudante')
                    ->placeholder('-'),
                TextEntry::make('nome_responsaveis')
                    ->placeholder('-'),
                TextEntry::make('telefone_familia')
                    ->placeholder('-'),
                TextEntry::make('contato_emergencia')
                    ->placeholder('-'),
                TextEntry::make('municipio')
                    ->placeholder('-'),
                TextEntry::make('programa_beneficios'),
                TextEntry::make('situacao'),
                TextEntry::make('observacoes')
                    ->placeholder('-')
                    ->columnSpanFull(),
                TextEntry::make('created_at')
                    ->dateTime()
                    ->placeholder('-'),
                TextEntry::make('updated_at')
                    ->dateTime()
                    ->placeholder('-'),
            ]);
    }
}
