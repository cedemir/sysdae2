<?php

namespace App\Filament\Resources\Alunos\Schemas;

use Filament\Forms\Components\TextInput;
use Filament\Forms\Components\Textarea;
use Filament\Schemas\Schema;

class AlunoForm
{
    public static function configure(Schema $schema): Schema
    {
        return $schema
            ->components([
                TextInput::make('cpf')
                    ->required(),
                TextInput::make('nome')
                    ->required(),
                TextInput::make('foto_path'),
                TextInput::make('sexo')
                    ->required(),
                TextInput::make('email')
                    ->label('Email address')
                    ->email(),
                TextInput::make('telefone_estudante')
                    ->tel(),
                TextInput::make('nome_responsaveis'),
                TextInput::make('telefone_familia')
                    ->tel(),
                TextInput::make('contato_emergencia'),
                TextInput::make('municipio'),
                TextInput::make('programa_beneficios')
                    ->required()
                    ->default('nao_recebe'),
                TextInput::make('situacao')
                    ->required()
                    ->default('cursando'),
                Textarea::make('observacoes')
                    ->columnSpanFull(),
            ]);
    }
}
