<?php

namespace App\Filament\Resources\Acessos;

use App\Filament\Resources\Acessos\Pages\CreateAcesso;
use App\Filament\Resources\Acessos\Pages\EditAcesso;
use App\Filament\Resources\Acessos\Pages\ListAcessos;
use App\Filament\Resources\Acessos\Schemas\AcessoForm;
use App\Filament\Resources\Acessos\Tables\AcessosTable;
use App\Models\Acesso;
use BackedEnum;
use Filament\Resources\Resource;
use Filament\Schemas\Schema;
use Filament\Support\Icons\Heroicon;
use Filament\Tables\Table;

class AcessoResource extends Resource
{
    protected static ?string $model = Acesso::class;

    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedRectangleStack;

    public static function form(Schema $schema): Schema
    {
        return AcessoForm::configure($schema);
    }

    public static function table(Table $table): Table
    {
        return AcessosTable::configure($table);
    }

    public static function getRelations(): array
    {
        return [
            //
        ];
    }

    public static function getPages(): array
    {
        return [
            'index' => ListAcessos::route('/'),
            'create' => CreateAcesso::route('/create'),
            'edit' => EditAcesso::route('/{record}/edit'),
        ];
    }
}
