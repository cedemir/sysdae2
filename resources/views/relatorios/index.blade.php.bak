<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Relatórios - SYSDAE</title>
    <style>
        body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #1d2433; margin: 0; background: #f4f5f8; }
        .caixa { background: #fff; max-width: 640px; margin: 30px auto; padding: 24px 28px; border-radius: 10px; border: 1px solid #d0d5dd; }
        h1 { font-size: 22px; margin: 0 0 4px; }
        p.sub { color: #6b7385; margin: 0 0 18px; font-size: 14px; }
        label { display: block; font-weight: 600; margin: 14px 0 4px; font-size: 14px; }
        input, select { width: 100%; padding: 9px 10px; border: 1px solid #c3c9d6; border-radius: 8px; font: inherit; box-sizing: border-box; }
        .linha { display: flex; gap: 12px; }
        .linha > div { flex: 1; }
        .erro { color: #b42318; font-size: 13px; margin-top: 4px; }
        .acoes { margin-top: 22px; display: flex; gap: 10px; }
        button { font: inherit; padding: 10px 16px; border-radius: 8px; border: 1px solid #c3c9d6; background: #fff; cursor: pointer; }
        button.principal { background: #1f5eff; border-color: #1f5eff; color: #fff; }
        a.voltar { display: inline-block; margin-top: 16px; color: #1f5eff; text-decoration: none; font-size: 14px; }
        .oculto { display: none; }
    </style>
</head>
<body>
    <div class="caixa">
        <h1>Relatórios</h1>
        <p class="sub">Escolha o relatório e, se quiser, filtre por aluno e por período.</p>

        <form method="GET" action="{{ route('relatorios.gerar') }}">
            <label for="tipo">Relatório</label>
            <select id="tipo" name="tipo" required>
                @foreach ($tipos as $chave => $tipo)
                    <option value="{{ $chave }}"
                            data-usa="{{ implode(',', $tipo['usa']) }}"
                            data-exige="{{ implode(',', $tipo['exige']) }}"
                            @selected(old('tipo') === $chave)>{{ $tipo['rotulo'] }}</option>
                @endforeach
            </select>
            @error('tipo') <div class="erro">{{ $message }}</div> @enderror

            <div id="campo-apto" class="oculto">
                <label for="apto">Número do apartamento</label>
                <input id="apto" name="apto" value="{{ old('apto') }}" maxlength="10" placeholder="Exemplo: 301">
                @error('apto') <div class="erro">{{ $message }}</div> @enderror
            </div>

            <div id="campo-aluno" class="oculto">
                <label for="cpf">CPF do aluno <span id="aluno-opcional">(opcional)</span></label>
                <input id="cpf" name="cpf" value="{{ old('cpf') }}" maxlength="14" placeholder="000.000.000-00">
                @error('cpf') <div class="erro">{{ $message }}</div> @enderror
            </div>

            <div id="campo-periodo" class="linha oculto">
                <div>
                    <label for="de">De (opcional)</label>
                    <input id="de" name="de" type="date" value="{{ old('de') }}">
                    @error('de') <div class="erro">{{ $message }}</div> @enderror
                </div>
                <div>
                    <label for="ate">Até (opcional)</label>
                    <input id="ate" name="ate" type="date" value="{{ old('ate') }}">
                    @error('ate') <div class="erro">{{ $message }}</div> @enderror
                </div>
            </div>

            <div class="acoes">
                <button class="principal" type="submit" name="formato" value="tela">Ver na tela</button>
                <button type="submit" name="formato" value="pdf" formtarget="_blank">Baixar PDF</button>
            </div>
        </form>

        <a class="voltar" href="/admin">&larr; Voltar ao painel</a>
    </div>

    <script>
        const tipo = document.getElementById('tipo');
        function atualizar() {
            const opcao = tipo.options[tipo.selectedIndex];
            const usa = (opcao.dataset.usa || '').split(',');
            const exige = (opcao.dataset.exige || '').split(',');
            document.getElementById('campo-apto').classList.toggle('oculto', !usa.includes('apto'));
            document.getElementById('campo-aluno').classList.toggle('oculto', !usa.includes('aluno'));
            document.getElementById('campo-periodo').classList.toggle('oculto', !usa.includes('periodo'));
            document.getElementById('aluno-opcional').textContent = exige.includes('aluno') ? '(obrigatório)' : '(opcional)';
        }
        tipo.addEventListener('change', atualizar);
        atualizar();
    </script>
</body>
</html>